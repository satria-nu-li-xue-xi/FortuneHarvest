{
	"schemaVersion": 1,
	"id": "fortune-harvest",
	"version": "${version}",
	"name": "Fortune Harvest",
	"description": "Tired of farming Wheat & Beetroots? So do I! at least now Fortune works here",
	"authors": [
		"QinMods"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/fortune-harvest/icon.png",
	"environment": "*",
